<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive project files
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^\.git - [F,L,NC]
    RewriteRule ^storage/logs/.* - [F,L,NC]
    RewriteRule ^storage/app/.* - [F,L,NC]
    RewriteRule ^storage/framework/.* - [F,L,NC]
    RewriteRule ^composer\.(json|lock) - [F,L,NC]
    RewriteRule ^package(-lock)?\.json - [F,L,NC]
    RewriteRule ^artisan - [F,L,NC]
    RewriteRule ^phpunit - [F,L,NC]
    RewriteRule ^app/ - [F,L,NC]
    RewriteRule ^config/ - [F,L,NC]
    RewriteRule ^database/ - [F,L,NC]
    RewriteRule ^bootstrap/ - [F,L,NC]
    RewriteRule ^routes/ - [F,L,NC]
    RewriteRule ^resources/ - [F,L,NC]
    RewriteRule ^vendor/ - [F,L,NC]
    RewriteRule ^tests/ - [F,L,NC]
    RewriteRule ^node_modules/ - [F,L,NC]

    # Redirect all traffic to /public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes
ServerSignature Off
FileETag None
