<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive files and folders in root
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^storage/logs/.* - [F,L,NC]
    RewriteRule ^composer\.(json|lock) - [F,L,NC]
    RewriteRule ^package(-lock)?\.json - [F,L,NC]
    RewriteRule ^artisan - [F,L,NC]
    RewriteRule ^app/ - [F,L,NC]
    RewriteRule ^config/ - [F,L,NC]
    RewriteRule ^database/ - [F,L,NC]

    # Redirect all traffic safely to /public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes
ServerSignature Off
